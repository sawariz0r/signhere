# Central trust service settings (docs/central-deployment.md).
CENTRAL_ORIGIN=https://signhere.prpl.se
# Printed by `keys init`. Leave empty only while running `keys init`.
CENTRAL_TRUST_ROOT=
CENTRAL_DATABASE_PASSWORD=replace-with-a-long-random-password
BIND_ADDRESS=127.0.0.1
PORT=3100
CENTRAL_RETENTION_DAYS=30

# Email for confirmation codes (required). SMTP shorthand:
CENTRAL_MAIL_SMTP_URL=smtps://user:password@smtp.example.com:465
CENTRAL_MAIL_SIGNHERE_MAIL_FROM=signhere <bekrafta@signhere.prpl.se>
# Or Resend:
# CENTRAL_MAIL_SIGNHERE_MAIL_PROVIDER=resend
# CENTRAL_MAIL_RESEND_API_KEY=re_...
