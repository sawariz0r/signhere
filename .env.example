# Run npm run setup:env to generate .env with a random database password.
# Set the exact public HTTPS origin before exposing the service to the internet.
BASE_URL=http://localhost:3000
PORT=3000
BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional. Docker Compose defaults to trusting proxies on private networks (uniquelocal),
# which fits Coolify/Traefik and other reverse proxies on the same Docker host.
# Set exact proxy IPs/CIDRs, comma-separated, to narrow it.
# TRUST_PROXY=uniquelocal
