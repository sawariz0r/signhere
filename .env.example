# Run npm run setup:env to generate .env with a random database password.
# Set the exact public HTTPS origin before exposing the service to the internet.
BASE_URL=http://localhost:3000
PORT=3000
BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=replace-with-a-long-random-migration-password
APP_DATABASE_PASSWORD=replace-with-a-different-long-random-runtime-password

# Optional. Docker Compose defaults to trusting proxies on private networks (uniquelocal),
# which fits Coolify/Traefik and other reverse proxies on the same Docker host.
# Set exact proxy IPs/CIDRs, comma-separated, to narrow it.
# TRUST_PROXY=uniquelocal

# Optional local (non-Docker) key directory and bundled Python override.
# Docker uses its protected /keys volume and its bundled Python automatically.
# SIGNHERE_KEYS_DIR=./data/keys
# SIGNHERE_SEAL_PYTHON=/absolute/path/to/signhere/.local/seal-python/bin/python
# BYO certificate secrets: mount files, then configure the paths (never literal passwords).
# SIGNHERE_SEAL_P12_FILE=/run/secrets/signhere-signing.p12
# SIGNHERE_SEAL_PASSWORD_FILE=/run/secrets/signhere-signing-password

# Optional unsigned recipient-link lifetime: integer 1–365 days; default 7.
# Applies to newly created/rotated links. Accepted links become 30-day receipts.
# SIGNHERE_SIGNING_LINK_TTL_DAYS=7
