{
  "name": "signhere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simple self-hosted document signing with portable evidence",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.local/postgres.env dist/server/index.js",
    "test": "tsx --test server/*.test.ts",
    "backup": "node --env-file-if-exists=.env --env-file-if-exists=.local/postgres.env scripts/backup.mjs",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "test:browser": "node --env-file-if-exists=.env --env-file-if-exists=.local/postgres.env tests/browser-smoke.mjs",
    "db:status": "node scripts/postgres-local.mjs status",
    "db:start": "node scripts/postgres-local.mjs start",
    "db:stop": "node scripts/postgres-local.mjs stop",
    "sealing:keys": "node --env-file-if-exists=.env --env-file-if-exists=.local/postgres.env scripts/sealing-keys.mjs",
    "verify:sealed": "node scripts/verify-sealed-evidence.mjs"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "express": "5.2.1",
    "express-rate-limit": "^8.0.0",
    "fflate": "0.8.3",
    "helmet": "^8.0.0",
    "lucide-react": "^0.577.0",
    "mupdf": "1.28.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "license": "AGPL-3.0-only"
}
